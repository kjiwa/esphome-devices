# Generated artifacts for hardware/heatpump-bridge. Needs KiCad 10 (kicad-cli), and OpenSCAD for `enclosure`, `enclosure-check` and `enclosure-images`.
# Gerber and drill header dates and file mtimes are fixed so `make fab` is byte-reproducible.
# `check` diffs the schematic SVG and the Gerbers against the committed files, then runs `enclosure-check`.
# The KiCad renders are regenerated by `images`, the enclosure renders by `enclosure-images`; `check` compares neither.

OPENSCAD ?= openscad
KICAD_CLI ?= /Applications/KiCad/KiCad.app/Contents/MacOS/kicad-cli
BOARD_DIR := hardware/heatpump-bridge
PCB := $(BOARD_DIR)/heatpump-bridge.kicad_pcb
SCH := $(BOARD_DIR)/heatpump-bridge.kicad_sch
IMAGES := docs/images
FAB_DIR := $(BOARD_DIR)/fabrication
FAB_ZIP := $(FAB_DIR)/heatpump-bridge-gerbers.zip
SCH_SVG := $(IMAGES)/heatpump-schematic.svg
# Content bounding box of the schematic plus a margin, in sheet millimetres.
# Measure with Playwright getBBox on the raw KiCad SVG again if the schematic changes.
SCH_VIEWBOX := 39 25 88 40
RENDER_ARGS := --width 1200 --height 800 --quality high --background opaque
GERBER_LAYERS := F.Cu,B.Cu,F.Mask,B.Mask,F.SilkS,B.SilkS,Edge.Cuts
# BSD mktemp ignores TMPDIR without a template.
MKTEMP := mktemp -d "$${TMPDIR:-/tmp}/esphome-devices.XXXXXX"
# Gerber and Excellon header lines that carry the date or tool version.
HEADER_FILTERS := -I '^G04' -I '^%TF' -I '^;'
ENCLOSURE_DIR := $(BOARD_DIR)/enclosure
ENCLOSURE_SCAD := $(ENCLOSURE_DIR)/heatpump-bridge-enclosure.scad
ENCLOSURE_CHECKS := $(ENCLOSURE_DIR)/interference.scad
ENCLOSURE_BUILD := build/enclosure
ENCLOSURE_STLS := $(ENCLOSURE_BUILD)/heatpump-bridge-box.stl $(ENCLOSURE_BUILD)/heatpump-bridge-lid.stl
ENCLOSURE_PNG_ARGS := --backend=Manifold --render --projection=o --colorscheme=Tomorrow --imgsize=1200,800 -D 'Part="assembly"'
ENCLOSURE_VIEW_closed := --camera=20,0,-8,40,0,35,200 -D Show_Lid=true -D Show_Wiring=false
ENCLOSURE_VIEW_open := --camera=20,0,-8,40,0,35,170 -D Show_Wiring=false
ENCLOSURE_VIEW_exploded := --camera=20,0,20,60,0,35,260 -D Show_Lid=true -D Show_Wiring=false -D Explode=18
ENCLOSURE_VIEW_section := --camera=20,0,-8,65,0,20,150 -D Show_Section=true
ENCLOSURE_PNGS := $(foreach view,closed open exploded section,$(IMAGES)/enclosure-$(view).png)

.PHONY: images fab check enclosure enclosure-check enclosure-images

images: $(IMAGES)/heatpump-board-top.png $(IMAGES)/heatpump-board-bottom.png $(SCH_SVG)

fab: $(FAB_ZIP)

check:
	@set -eu; \
	export KICAD_CONFIG_HOME="$$($(MKTEMP))"; \
	work="$$($(MKTEMP))"; trap 'rm -rf "$$work" "$$KICAD_CONFIG_HOME"' EXIT; \
	$(MAKE) --no-print-directory SCH_OUT="$$work/sch" FAB_OUT="$$work/fab" generate-svg generate-gerbers; \
	diff -u $(SCH_SVG) "$$work/sch/heatpump-schematic.svg"; \
	mkdir "$$work/committed"; unzip -q $(FAB_ZIP) -d "$$work/committed"; \
	diff -r $(HEADER_FILTERS) "$$work/committed" "$$work/fab"; \
	echo "check: schematic SVG and Gerbers match"
	@$(MAKE) --no-print-directory enclosure-check

enclosure: $(ENCLOSURE_STLS)

enclosure-images: $(ENCLOSURE_PNGS)

$(IMAGES)/enclosure-%.png: $(ENCLOSURE_SCAD)
	@mkdir -p $(IMAGES)
	$(OPENSCAD) $(ENCLOSURE_PNG_ARGS) $(ENCLOSURE_VIEW_$*) -o $@ $<

$(ENCLOSURE_BUILD)/heatpump-bridge-%.stl: $(ENCLOSURE_SCAD)
	@mkdir -p $(ENCLOSURE_BUILD)
	$(OPENSCAD) -D 'Part="$*"' -o $@ $<

# OpenSCAD prints this and exits 1 when a top-level object is empty, which is how an interference check passes.
ENCLOSURE_EMPTY := Current top level object is empty.
ENCLOSURE_EMPTY_CHECKS := box-boards box-keepouts box-detail lid-box lid-boards lid-keepouts lid-detail tie-hole pry-slot
ENCLOSURE_SOLID_CHECKS := lid-lead lead-notch rail-support ledge-support lid-snap carrier-catch tie-block
ENCLOSURE_SELFTESTS := box-keepouts:Board_Clearance=-0.5 box-detail:Board_Clearance=-0.5 lid-detail:Module_Width=30 pry-slot:Pry_Width=0
ENCLOSURE_EMPTY_SELFTESTS := lid-snap:Snap_Depth=0 carrier-catch:Catch_Reach=0
ENCLOSURE_FEATURE_OFF := Snap_Depth=0 Tie_Width=0 Catch_Reach=0 Pry_Width=0
ENCLOSURE_PARTS := box lid assembly
ENCLOSURE_ASSEMBLY_OPTIONS := Explode=18 Show_Lid=true Show_Section=true Show_Wiring=false

enclosure-check:
	@set -eu; \
	work="$$($(MKTEMP))"; trap 'rm -rf "$$work"' EXIT; \
	log="$$work/log"; \
	run() { status=0; rm -f "$$work/out.stl"; "$(OPENSCAD)" -o "$$work/out.stl" "$$@" >"$$log" 2>&1 || status=$$?; }; \
	fail() { echo "enclosure-check: FAIL $$1" >&2; tail -n 8 "$$log" | sed 's/^/  /' >&2; exit 1; }; \
	clean() { ! grep -Eq 'WARNING|ERROR' "$$log"; }; \
	expect_empty() { run "$$@"; [ "$$status" -eq 1 ] && grep -Fxq '$(ENCLOSURE_EMPTY)' "$$log" && clean; }; \
	expect_solid() { run "$$@"; [ "$$status" -eq 0 ] && clean && [ -s "$$work/out.stl" ]; }; \
	for name in $(ENCLOSURE_EMPTY_CHECKS); do \
	  expect_empty -D "Check=\"$$name\"" $(ENCLOSURE_CHECKS) || fail "$$name should be empty"; \
	  echo "enclosure-check: ok $$name (empty)"; \
	done; \
	for name in $(ENCLOSURE_SOLID_CHECKS); do \
	  expect_solid -D "Check=\"$$name\"" $(ENCLOSURE_CHECKS) || fail "$$name should be solid"; \
	  echo "enclosure-check: ok $$name (solid)"; \
	done; \
	for test in $(ENCLOSURE_SELFTESTS); do \
	  name="$${test%%:*}"; option="$${test#*:}"; \
	  expect_solid -D "Check=\"$$name\"" -D "$$option" $(ENCLOSURE_CHECKS) || fail "self-test: $$name with $$option should be solid"; \
	  echo "enclosure-check: ok self-test $$name ($$option)"; \
	done; \
	for test in $(ENCLOSURE_EMPTY_SELFTESTS); do \
	  name="$${test%%:*}"; option="$${test#*:}"; \
	  expect_empty -D "Check=\"$$name\"" -D "$$option" $(ENCLOSURE_CHECKS) || fail "self-test: $$name with $$option should be empty"; \
	  echo "enclosure-check: ok self-test $$name ($$option, empty)"; \
	done; \
	for name in $(ENCLOSURE_PARTS); do \
	  expect_solid -D "Part=\"$$name\"" $(ENCLOSURE_SCAD) || fail "$$name should render without warnings"; \
	  echo "enclosure-check: ok part $$name"; \
	done; \
	for option in $(ENCLOSURE_ASSEMBLY_OPTIONS); do \
	  expect_solid -D 'Part="assembly"' -D "$$option" $(ENCLOSURE_SCAD) || fail "assembly with $$option should render without warnings"; \
	  echo "enclosure-check: ok assembly $$option"; \
	done; \
	for option in $(ENCLOSURE_FEATURE_OFF); do \
	  for name in box lid; do \
	    expect_solid -D "Part=\"$$name\"" -D "$$option" $(ENCLOSURE_SCAD) || fail "$$name with $$option should render without warnings"; \
	  done; \
	  expect_solid -D 'Part="assembly"' -D Show_Lid=true -D "$$option" $(ENCLOSURE_SCAD) || fail "assembly with $$option should render without warnings"; \
	  echo "enclosure-check: ok feature off $$option"; \
	done; \
	run -D Rail_Thickness=3 $(ENCLOSURE_SCAD); \
	{ [ "$$status" -ne 0 ] && grep -Fq 'Rails overlap the ESP32 header rows' "$$log"; } || fail "Rail_Thickness=3 should fail its assert"; \
	echo "enclosure-check: ok assert"

$(IMAGES)/heatpump-board-top.png: $(PCB)
	@mkdir -p $(IMAGES)
	@set -eu; \
	export KICAD_CONFIG_HOME="$$($(MKTEMP))"; trap 'rm -rf "$$KICAD_CONFIG_HOME"' EXIT; \
	$(KICAD_CLI) pcb render $(RENDER_ARGS) --side top -o $@ $<

$(IMAGES)/heatpump-board-bottom.png: $(PCB)
	@mkdir -p $(IMAGES)
	@set -eu; \
	export KICAD_CONFIG_HOME="$$($(MKTEMP))"; trap 'rm -rf "$$KICAD_CONFIG_HOME"' EXIT; \
	$(KICAD_CLI) pcb render $(RENDER_ARGS) --side bottom -o $@ $<

$(SCH_SVG): $(SCH)
	@mkdir -p $(IMAGES)
	@set -eu; \
	export KICAD_CONFIG_HOME="$$($(MKTEMP))"; trap 'rm -rf "$$KICAD_CONFIG_HOME"' EXIT; \
	$(MAKE) --no-print-directory SCH_OUT="$(IMAGES)" generate-svg

$(FAB_ZIP): $(PCB)
	@set -eu; \
	export KICAD_CONFIG_HOME="$$($(MKTEMP))"; \
	work="$$($(MKTEMP))"; trap 'rm -rf "$$work" "$$KICAD_CONFIG_HOME"' EXIT; \
	$(MAKE) --no-print-directory FAB_OUT="$$work/fab" generate-gerbers; \
	mkdir -p $(FAB_DIR); rm -f $@; \
	(cd "$$work/fab" && zip -q -X "$(CURDIR)/$@" $$(ls | sort))

# Internal: write the schematic SVG (stable title, cropped viewBox, opaque white background as first child) to $(SCH_OUT), or Gerbers and drill to $(FAB_OUT).
.PHONY: generate-svg generate-gerbers
generate-svg:
	$(KICAD_CLI) sch export svg --black-and-white --exclude-drawing-sheet -o $(SCH_OUT) $(SCH)
	sed -e 's|^<title>.*</title>|<title>Schematic of the heat pump bridge carrier board</title>|' \
	    -e 's|^  <desc>.*</desc>|  <desc>Two 1x5 headers joined through a four-channel 3.3 V to 5 V level converter.</desc>|' \
	    -e 's|^  width="[^"]*mm" height="[^"]*mm" viewBox="[^"]*">|  width="100%" viewBox="$(SCH_VIEWBOX)"><rect x="$(word 1,$(SCH_VIEWBOX))" y="$(word 2,$(SCH_VIEWBOX))" width="$(word 3,$(SCH_VIEWBOX))" height="$(word 4,$(SCH_VIEWBOX))" fill="#ffffff"/>|' \
	    $(SCH_OUT)/heatpump-bridge.svg > $(SCH_OUT)/heatpump-schematic.svg
	rm $(SCH_OUT)/heatpump-bridge.svg
	@set -eu; svg="$(SCH_OUT)/heatpump-schematic.svg"; \
	grep -q '<title>Schematic of the heat pump bridge carrier board</title>' "$$svg" || { echo "generate-svg: title not injected" >&2; exit 1; }; \
	grep -q 'viewBox="$(SCH_VIEWBOX)"' "$$svg" || { echo "generate-svg: viewBox not injected" >&2; exit 1; }; \
	grep -q 'fill="[#]ffffff"/>' "$$svg" || { echo "generate-svg: white background rect not injected" >&2; exit 1; }

generate-gerbers:
	$(KICAD_CLI) pcb export gerbers --layers $(GERBER_LAYERS) --no-x2 -o $(FAB_OUT)/ $(PCB)
	$(KICAD_CLI) pcb export drill --format excellon --excellon-separate-th -o $(FAB_OUT)/ $(PCB)
	rm -f $(FAB_OUT)/*.gbrjob
	@set -eu; for f in $(FAB_OUT)/*; do \
	  sed -E '/CreationDate|date /s/20[0-9]{2}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}(-[0-9]{2}:[0-9]{2})?/2026-01-01T00:00:00/' "$$f" > "$$f.tmp"; \
	  mv "$$f.tmp" "$$f"; \
	done
	touch -t 202601010000 $(FAB_OUT)/*
