# Generated artifacts for hardware/heatpump-bridge. Needs KiCad 10 (kicad-cli).
# Gerber and drill header dates and file mtimes are fixed so `make fab` is byte-reproducible.
# `check` diffs the schematic SVG and the Gerbers against the committed files.
# The 3D renders are regenerated by `images` but not compared by `check`.

KICAD_CLI ?= /Applications/KiCad/KiCad.app/Contents/MacOS/kicad-cli
BOARD_DIR := hardware/heatpump-bridge
PCB := $(BOARD_DIR)/heatpump-bridge.kicad_pcb
SCH := $(BOARD_DIR)/heatpump-bridge.kicad_sch
IMAGES := docs/images
FAB_DIR := $(BOARD_DIR)/fabrication
FAB_ZIP := $(FAB_DIR)/heatpump-bridge-gerbers.zip
SCH_SVG := $(IMAGES)/heatpump-schematic.svg
# Content bounding box of the schematic plus a margin, in sheet millimetres.
# Measure with Playwright getBBox on the raw KiCad SVG again if the schematic changes.
SCH_VIEWBOX := 39 25 88 40
RENDER_ARGS := --width 1200 --height 800 --quality high --background opaque
GERBER_LAYERS := F.Cu,B.Cu,F.Mask,B.Mask,F.SilkS,B.SilkS,Edge.Cuts
# BSD mktemp ignores TMPDIR without a template.
MKTEMP := mktemp -d "$${TMPDIR:-/tmp}/esphome-devices.XXXXXX"
# Gerber and Excellon header lines that carry the date or tool version.
HEADER_FILTERS := -I '^G04' -I '^%TF' -I '^;'

.PHONY: images fab check

images: $(IMAGES)/heatpump-board-top.png $(IMAGES)/heatpump-board-bottom.png $(SCH_SVG)

fab: $(FAB_ZIP)

check:
	@set -eu; \
	export KICAD_CONFIG_HOME="$$($(MKTEMP))"; \
	work="$$($(MKTEMP))"; trap 'rm -rf "$$work" "$$KICAD_CONFIG_HOME"' EXIT; \
	$(MAKE) --no-print-directory SCH_OUT="$$work/sch" FAB_OUT="$$work/fab" generate-svg generate-gerbers; \
	diff -u $(SCH_SVG) "$$work/sch/heatpump-schematic.svg"; \
	mkdir "$$work/committed"; unzip -q $(FAB_ZIP) -d "$$work/committed"; \
	diff -r $(HEADER_FILTERS) "$$work/committed" "$$work/fab"; \
	echo "check: schematic SVG and Gerbers match"

$(IMAGES)/heatpump-board-top.png: $(PCB)
	@mkdir -p $(IMAGES)
	@set -eu; \
	export KICAD_CONFIG_HOME="$$($(MKTEMP))"; trap 'rm -rf "$$KICAD_CONFIG_HOME"' EXIT; \
	$(KICAD_CLI) pcb render $(RENDER_ARGS) --side top -o $@ $<

$(IMAGES)/heatpump-board-bottom.png: $(PCB)
	@mkdir -p $(IMAGES)
	@set -eu; \
	export KICAD_CONFIG_HOME="$$($(MKTEMP))"; trap 'rm -rf "$$KICAD_CONFIG_HOME"' EXIT; \
	$(KICAD_CLI) pcb render $(RENDER_ARGS) --side bottom -o $@ $<

$(SCH_SVG): $(SCH)
	@mkdir -p $(IMAGES)
	@set -eu; \
	export KICAD_CONFIG_HOME="$$($(MKTEMP))"; trap 'rm -rf "$$KICAD_CONFIG_HOME"' EXIT; \
	$(MAKE) --no-print-directory SCH_OUT="$(IMAGES)" generate-svg

$(FAB_ZIP): $(PCB)
	@set -eu; \
	export KICAD_CONFIG_HOME="$$($(MKTEMP))"; \
	work="$$($(MKTEMP))"; trap 'rm -rf "$$work" "$$KICAD_CONFIG_HOME"' EXIT; \
	$(MAKE) --no-print-directory FAB_OUT="$$work/fab" generate-gerbers; \
	mkdir -p $(FAB_DIR); rm -f $@; \
	(cd "$$work/fab" && zip -q -X "$(CURDIR)/$@" $$(ls | sort))

# Internal: write the schematic SVG (stable title, cropped viewBox, opaque white background as first child) to $(SCH_OUT), or Gerbers and drill to $(FAB_OUT).
.PHONY: generate-svg generate-gerbers
generate-svg:
	$(KICAD_CLI) sch export svg --black-and-white --exclude-drawing-sheet -o $(SCH_OUT) $(SCH)
	sed -e 's|^<title>.*</title>|<title>Schematic of the heat pump bridge carrier board</title>|' \
	    -e 's|^  <desc>.*</desc>|  <desc>Two 1x5 headers joined through a four-channel 3.3 V to 5 V level converter.</desc>|' \
	    -e 's|^  width="[^"]*mm" height="[^"]*mm" viewBox="[^"]*">|  width="100%" viewBox="$(SCH_VIEWBOX)"><rect x="$(word 1,$(SCH_VIEWBOX))" y="$(word 2,$(SCH_VIEWBOX))" width="$(word 3,$(SCH_VIEWBOX))" height="$(word 4,$(SCH_VIEWBOX))" fill="#ffffff"/>|' \
	    $(SCH_OUT)/heatpump-bridge.svg > $(SCH_OUT)/heatpump-schematic.svg
	rm $(SCH_OUT)/heatpump-bridge.svg
	@set -eu; svg="$(SCH_OUT)/heatpump-schematic.svg"; \
	grep -q '<title>Schematic of the heat pump bridge carrier board</title>' "$$svg" || { echo "generate-svg: title not injected" >&2; exit 1; }; \
	grep -q 'viewBox="$(SCH_VIEWBOX)"' "$$svg" || { echo "generate-svg: viewBox not injected" >&2; exit 1; }; \
	grep -q 'fill="[#]ffffff"/>' "$$svg" || { echo "generate-svg: white background rect not injected" >&2; exit 1; }

generate-gerbers:
	$(KICAD_CLI) pcb export gerbers --layers $(GERBER_LAYERS) --no-x2 -o $(FAB_OUT)/ $(PCB)
	$(KICAD_CLI) pcb export drill --format excellon --excellon-separate-th -o $(FAB_OUT)/ $(PCB)
	rm -f $(FAB_OUT)/*.gbrjob
	@set -eu; for f in $(FAB_OUT)/*; do \
	  sed -E '/CreationDate|date /s/20[0-9]{2}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}(-[0-9]{2}:[0-9]{2})?/2026-01-01T00:00:00/' "$$f" > "$$f.tmp"; \
	  mv "$$f.tmp" "$$f"; \
	done
	touch -t 202601010000 $(FAB_OUT)/*
